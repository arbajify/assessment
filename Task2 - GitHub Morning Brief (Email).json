      "id": "aa9f6bf1-dd7e-46ce-9ba2-180e4ce25f99",
      "name": "Alert Email (Failure)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1360,
        80
      ],
      "webhookId": "e08883f6-dcbd-4220-a394-c79e2c86f230",
      "credentials": {
        "gmailOAuth2": {
          "id": "tlwm6aNI49UNJCHk",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const repos = $input.first().json.items || [];\nif (!repos.length) {\n  throw new Error('GitHub returned no repositories');\n}\nconst top5 = repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map(r => ({\n    name: r.full_name,\n    stars: r.stargazers_count,\n    url: r.html_url,\n    description: r.description || 'No description',\n    language: r.language || 'n/a'\n  }));\nreturn top5.map(r => ({ json: r }));"
      },
      "id": "b9d262c5-9af1-41a4-bab4-781cf24177d1",
      "name": "Top 5 Repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.name }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "readme"
            }
          }
        }
      },
      "id": "3972e10c-373d-4915-b54b-c77465a2ee3c",
      "name": "Get README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        272
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst originals = $('Top 5 Repos').all();\nconst enriched = $input.all();\nlet failed = 0;\nconst rows = originals.map((o, i) => {\n  const r = o.json;\n  const e = enriched[i] ? enriched[i].json : {};\n  const readme = typeof e.readme === 'string' ? e.readme : '';\n  if (!readme) failed++;\n  const snippet = readme\n    ? esc(readme.replace(/\\s+/g, ' ').slice(0, 200)) + '...'\n    : 'README unavailable';\n  return '<li><b><a href=\"' + r.url + '\">' + esc(r.name) + '</a></b> - stars: ' + r.stars + ' (' + esc(r.language) + ')<br>' + esc(r.description) + '<br><i>' + snippet + '</i></li>';\n});\nconst topStars = originals.length ? originals[0].json.stars : 0;\nconst warning = failed ? '<p><b>Note:</b> README fetch failed for ' + failed + ' repo(s).</p>' : '';\nconst html = '<h2>Daily GitHub Brief: topic n8n</h2><ol>' + rows.join('') + '</ol>' + warning;\nreturn [{ json: { html, topStars, failed } }];"
      },
      "id": "e8c31ded-3e06-4f28-85bb-09b6361b9ffa",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        272
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.topStars }}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5ab73b3a-7874-471d-a7c1-4435958a620c",
      "name": "Stars Threshold Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
