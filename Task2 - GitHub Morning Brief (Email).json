      "id": "9c1c4386-10eb-405e-9c0a-b3c2307b9283",
      "name": "Search GitHub Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "",
        "subject": "ALERT: Morning brief workflow failed",
        "message": "=<p>The GitHub morning brief could not be built.</p><pre>{{ JSON.stringify($json.error || $json) }}</pre>",
